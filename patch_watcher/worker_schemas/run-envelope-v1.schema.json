{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patch-watcher.local/schemas/run-envelope-v1.schema.json",
  "title": "Patch Watcher RunEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "content_hash", "created_at", "change_id",
    "patchset", "revision_sha", "worker_profile_id", "worker_profile_hash",
    "task", "capabilities", "checkout_mode", "logical_paths", "budgets",
    "isolation_mode", "network_mode", "endpoints", "ltvm_owner_id",
    "evidence", "artifact_policy", "instructions_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "format": "date-time"},
    "change_id": {"type": "string", "minLength": 1},
    "patchset": {"type": "integer", "minimum": 1},
    "revision_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "worker_profile_id": {"type": "string", "minLength": 1},
    "worker_profile_hash": {"$ref": "#/$defs/hash"},
    "task": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
    "checkout_mode": {"enum": ["read_only", "writable"]},
    "logical_paths": {"$ref": "#/$defs/logicalPaths"},
    "budgets": {"$ref": "#/$defs/limits"},
    "isolation_mode": {"type": "string", "minLength": 1},
    "network_mode": {"type": "string", "minLength": 1},
    "endpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["controller", "broker", "heartbeat", "report", "artifact"],
      "properties": {
        "controller": {"type": "string", "minLength": 1},
        "broker": {"type": "string", "minLength": 1},
        "heartbeat": {"type": "string", "minLength": 1},
        "report": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1}
      }
    },
    "ltvm_owner_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "reference", "hash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "hash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "artifact_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["collect", "retention_days", "max_bytes"],
      "properties": {
        "collect": {"type": "boolean"},
        "retention_days": {"type": "integer", "minimum": 0},
        "max_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "instructions_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "logicalPaths": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^/"},
      "additionalProperties": {"enum": ["read_only", "read_write", "private_read_only", "private_read_write"]}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cpu_count": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "disk_bytes": {"type": "integer", "minimum": 1},
        "process_count": {"type": "integer", "minimum": 1},
        "runtime_seconds": {"type": "integer", "minimum": 1},
        "inactivity_seconds": {"type": "integer", "minimum": 1},
        "output_bytes": {"type": "integer", "minimum": 1},
        "action_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
